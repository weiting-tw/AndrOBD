<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <service
            android:name="com.fr3ts0n.androbd.plugin.csv.CsvDataLogger"
            android:exported="true">
            <intent-filter>
                <action android:name="com.fr3ts0n.androbd.plugin.IDENTIFY" />
                <category android:name="com.fr3ts0n.androbd.plugin.REQUEST" />
            </intent-filter>
        </service>

        <receiver
            android:name="com.fr3ts0n.androbd.plugin.csv.CsvLoggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.fr3ts0n.androbd.plugin.IDENTIFY" />
                <category android:name="com.fr3ts0n.androbd.plugin.REQUEST" />
            </intent-filter>
        </receiver>

        <provider
            android:authorities="com.fr3ts0n.androbd.plugin.csv.provider"
            android:name="com.fr3ts0n.androbd.plugin.csv.CsvProvider"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- config screen — no LAUNCHER (bundled, not a separate app icon) -->
        <activity
            android:name="com.fr3ts0n.androbd.plugin.csv.SettingsActivity"
            android:exported="true"/>

    </application>
</manifest>
